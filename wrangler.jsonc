{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tun9i-site",
  "main": "worker.js",
  "compatibility_date": "2026-07-13",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // 作業系統博物館的磁碟映像(worker.js 的 /os/disk/*)
  "r2_buckets": [
    { "binding": "OS_DISK", "bucket_name": "tun9i-os" }
  ],
  "workers_dev": true,
  "routes": [
    { "pattern": "tun9i.com", "custom_domain": true },
    { "pattern": "www.tun9i.com", "custom_domain": true }
  ]
}
